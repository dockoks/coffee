#!/usr/bin/env bash
#
# Builds .build/release/Coffee.app for Apple silicon and Intel Macs.
#
#   VERSION            version shown in About and compared by Check for Updates (default: Info.plist)
#   CODESIGN_IDENTITY  "-" (default) signs ad hoc, for running locally; a "Developer ID
#                      Application" identity signs for distribution (see script/release)

set -Eeuo pipefail
IFS=$'\n\t'

HERE="$(cd "$(dirname "$0")" && pwd)"
TOP_LEVEL="$(cd "$HERE/../" && pwd)"

cd "$TOP_LEVEL"

APP_BUNDLE=".build/release/Coffee.app"
CODESIGN_IDENTITY="${CODESIGN_IDENTITY:--}"

# Build
swift build -c release --arch arm64 --arch x86_64
BIN_DIR="$(swift build -c release --arch arm64 --arch x86_64 --show-bin-path)"

# Assemble .app bundle
rm -rf "$APP_BUNDLE"
mkdir -p "${APP_BUNDLE}/Contents/MacOS" "${APP_BUNDLE}/Contents/Resources"
cp Bundle/Info.plist "${APP_BUNDLE}/Contents/"
cp "${BIN_DIR}/Coffee" "${APP_BUNDLE}/Contents/MacOS/"
cp Sources/Sounds/pour.wav "${APP_BUNDLE}/Contents/Resources/Pour.wav"  # see script/render-pour-sound

PLIST="${APP_BUNDLE}/Contents/Info.plist"
if [[ -n "${VERSION:-}" ]]; then
    /usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString ${VERSION}" "$PLIST"
fi
BUILD_NUMBER="$(git rev-list --count HEAD 2>/dev/null || echo 1)"
/usr/libexec/PlistBuddy -c "Set :CFBundleVersion ${BUILD_NUMBER}" "$PLIST"

# Compile asset catalog. actool reports to stdout and exits 0 even on failure, so keep its
# warnings and errors but drop the list of files it wrote.
xcrun actool \
    --output-format human-readable-text \
    --compile "${APP_BUNDLE}/Contents/Resources" \
    --platform macosx \
    --minimum-deployment-target 14.0 \
    --app-icon AppIcon \
    --output-partial-info-plist /dev/null \
    Sources/Coffee/Assets.xcassets |
    awk '/^\/\* com\.apple\.actool\./ { show = !/compilation-results/ } show'

# Codesign. Notarization needs the hardened runtime and a secure timestamp.
if [[ "$CODESIGN_IDENTITY" == "-" ]]; then
    codesign --sign - --entitlements Bundle/Coffee.entitlements --force "$APP_BUNDLE"
else
    codesign --sign "$CODESIGN_IDENTITY" --entitlements Bundle/Coffee.entitlements \
        --options runtime --timestamp --force "$APP_BUNDLE"
fi
codesign --verify --strict "$APP_BUNDLE"
